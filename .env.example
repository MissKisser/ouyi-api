# Example environment for docker-compose.yml / docker-compose.dev.yml.
#
# Copy to .env and fill in:
#   cp .env.example .env
#
# .env is git-ignored (see .gitignore). Never commit it.

# ─── Networking ──────────────────────────────────────────────────────────────
# A single, intentionally uncommon port. Change this if 4117 conflicts on
# the host.
SERVER_PORT=4117

# 127.0.0.1 is the safe default — only the host (and processes with
# loopback access, e.g. a fronting nginx on the same host) can reach the
# container. Use "<host-ip>" or "0.0.0.0" ONLY if a reverse proxy is NOT
# running on the host and you want this container reachable on its LAN IP.
SERVER_BIND=127.0.0.1

# ─── Web (dev compose only) ──────────────────────────────────────────────────
WEB_PORT=5173
WEB_BIND=127.0.0.1

# ─── Logging ─────────────────────────────────────────────────────────────────
# Same syntax as env_logger / tracing-subscriber's EnvFilter.
RUST_LOG=info

# ─── Resource limits ─────────────────────────────────────────────────────────
# Compose mem_limit; tune for your workload.
MEM_LIMIT=1g
